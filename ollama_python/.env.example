# ELAW AI configuration. Copy to .env and fill in. NEVER commit .env.
# Secrets live only on the server, in this file. The browser never sees them.

# ---- App ----
DOMAIN=                             # standalone server only (docker-compose.standalone.yml), e.g. ai.elawmaran.tech
APP_ENV=development                 # production on the server
PUBLIC_URL=http://localhost:8000    # where /login etc. are served; used in email links
APP_URL=http://localhost:8501       # the chat app. In production both are https://ai.elawmaran.tech
SECURE_COOKIES=false                # true in production (HTTPS only)
TRUST_PROXY=false                   # true behind Caddy, so real client IPs are logged
ALLOWED_ORIGINS=                    # extra origins allowed to call the API (comma-separated)

# ---- Database ----
# Local dev default (if unset): SQLite file at ./data/elaw.db
# DATABASE_URL=postgresql+psycopg://elaw:CHANGE_ME@localhost:5432/elaw
POSTGRES_PASSWORD=                  # used by docker-compose for the elaw-db container

# ---- Sessions & tokens ----
SESSION_DAYS=7
VERIFY_TOKEN_MINUTES=30
RESET_TOKEN_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ---- Email (free SMTP mailbox, no paid OTP/SMS) ----
EMAIL_PROVIDER=console              # console = print links in the terminal (dev only); smtp for real email
SMTP_HOST=                          # e.g. smtp.gmail.com
SMTP_PORT=587                       # 587 STARTTLS, or 465 SSL
SMTP_USERNAME=                      # e.g. your Gmail address
SMTP_PASSWORD=                      # Gmail: a 16-character App Password, NOT your normal password
SMTP_FROM_EMAIL=                    # usually the same as SMTP_USERNAME
SMTP_FROM_NAME=ELAW AI
SMTP_USE_SSL=false
EMAIL_DAILY_LIMIT=400               # stays under Gmail's ~500/day free limit

# ---- Cost ----
COST_MODE=free                      # free = paid AI providers (OpenAI etc.) are blocked

# ---- Prompt Builder (Ollama only; all limits are set here) ----
GUEST_DAILY_LIMIT=5                 # builds per 24h for visitors without an account (by hashed IP)
FREE_DAILY_LIMIT=20                 # builds per 24h for logged-in customers
ADMIN_DAILY_LIMIT=200
PROMPT_BUILDER_PER_MINUTE=4         # burst limit per visitor
PROMPT_BUILDER_MAX_INPUT=1000       # characters
PROMPT_BUILDER_MAX_TOKENS=600       # max tokens the model may write per build
PROMPT_BUILDER_TIMEOUT=150          # seconds
PROMPT_BUILDER_QUEUE_WAIT=90        # seconds to wait for the shared Ollama queue
# PROMPT_BUILDER_MODEL=             # defaults to DEFAULT_MODEL

# ---- Chat (existing settings) ----
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3:4b-instruct
ALLOWED_MODELS=qwen3:4b-instruct
MAX_CONCURRENT=1
