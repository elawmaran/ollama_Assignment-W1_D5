# ELAW AI routing for /opt/travel-crm/Caddyfile (the shared Caddy in the travel-crm stack).
# ai.elawmaran.tech is the domain. llm.elawmaran.tech was retired on 2026-11-23 (301 redirect to ai.).
# Auth pages and APIs go to elaw-auth; everything else (chat, /admin, websockets) to Streamlit.

(elaw_app) {
	encode gzip
	@auth path /api/* /login /register /verify-email /resend-verification /forgot-password /reset-password /logout /auth-assets/*
	handle @auth {
		reverse_proxy elaw-auth:8000
	}
	handle {
		reverse_proxy elaw-ai:8501 {
			flush_interval -1
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

ai.elawmaran.tech {
	import elaw_app
}

# Retired old domain: permanent redirect keeps old links, bookmarks and emailed tokens working.
llm.elawmaran.tech {
	redir https://ai.elawmaran.tech{uri} 301
}

# Plain-IP access (http://201.18.199.87) goes to the main domain.
http:// {
	redir https://ai.elawmaran.tech{uri} 302
}
